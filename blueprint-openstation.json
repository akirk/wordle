{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Wordle",
		"description": "A Wordle game plugin for WordPress",
		"author": "Alex Kirk"
	},
	"landingPage": "/wp-admin/index.php?desktop_mode_portal=1",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/openstation/releases/latest/download/openstation.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/wordle",
				"ref": "main",
				"refType": "branch"
			},
			"options": {
				"targetFolderName": "wordle"
			}
		}
	]
}
